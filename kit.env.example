# kit.env.example —— 本机配置样例。复制为仓库根的 kit.env 后按需填写（kit.env 已在 .gitignore 里，不会被提交）：
#   cp kit.env.example kit.env
#
# 读取规则（kit_env.py / kit_env.js / kit_env.sh 三处同口径）：
#   · 只解析 KEY=VALUE 行，可带 export 前缀、可加引号；# 开头为注释；不执行任何代码。
#   · 环境变量优先：同名变量已在环境里时，kit.env 的值不生效。
#   · 值里的 ~ 与 $VAR / ${VAR} 会展开（只展开已设的变量）。
#   · 留空（KEY=）等于没设，脚本走缺省。
# 工作区根的判定：VRC_WS（环境变量或下面这行）＞按脚本位置推算（开发工具/通用工具/ 往上两级＝仓库根）。

# ── 工作区 ──────────────────────────────────────────────
# 工作区根（放客户工程、_施工记录.md、开发工具/ 的目录）。缺省＝本仓库根（即本文件所在目录）。
# 工具仓库与工作区分开放时才填：脚本先读工具仓库根的 kit.env，再把工作区切到这里（那边的 kit.env 不再读）。
VRC_WS=
# baseline_recheck.sh 巡检的工程目录：固定含 COMM-*/，这里追加其它 glob（空格分隔，带尾斜杠），如 "私单_*/ 工程B/"
EXTRA_PROJECT_GLOBS=
# distill_collect.py 存放「蒸馏记录.md」与采集时刻的目录（相对工作区）
DISTILL_DIR=_长程任务_20260918

# ── Unity ──────────────────────────────────────────────
# Unity Hub 的编辑器安装根（其下是 <版本>/Editor/Unity）。缺省 ~/Unity/Hub/Editor
UNITY_EDITOR_ROOT=~/Unity/Hub/Editor
# 编辑器版本（VRChat 现行要求）
UNITY_VERSION=2022.3.22f1
# 直接指定编辑器可执行文件（设了就不再用上面两项拼）。例：~/Unity/Hub/Editor/2022.3.22f1/Editor/Unity
UNITY_BIN=
# 编辑器 Data 目录（unity_csc.sh 的离线编译器、selftest_* 的 mono/mcs 从这里取）。缺省＝UNITY_BIN 同级的 Data
UNITY_DATA=
# unity_run.sh 起图形界面时的 DISPLAY 兜底（环境里已有 DISPLAY 时不用它）。远程桌面/Xvfb 常见 :10.0 或 :99
DISPLAY_FALLBACK=:0
# unity_run.sh 批处理串行锁（全机一把）。缺省 $XDG_RUNTIME_DIR/vrc-kit-unity-batch.lock
UNITY_BATCH_LOCK=

# ── 素材与存档（可选）─────────────────────────────────────
# 素材库根：其下每个商品一个目录，名为「<商品名>-<Booth 商品号>」。不设则 dsh_task.js / check_parts_doc.py 跳过素材库查档。
VRC_ASSET_ROOT=
# 工程存档目录（打包/备份用；目前只供文档与手工流程引用）
ARCHIVE_ROOT=

# ── 图像与字体 ───────────────────────────────────────────
# 标注图里写中文用的字体（cjk_font.py 首选；.ttc 可写 路径:index，如 /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc:2）
CJK_FONT=
# ComfyUI 安装目录（comfy_redraw.py 的 input/ output/ 在其下）与 API 地址
COMFYUI_DIR=~/comfyui
COMFYUI_API=http://127.0.0.1:8188

# ── 可选编排层（不用可全部留空）─────────────────────────────
# DSH（DeepSeek 执行代理）：@deepseek-ai/dsh 的 lib/bin.js 路径。缺省找 ~/.local/opt/dsh-*（取最新）与全局 npm 前缀
DSH_BIN=
# DSH 交接锁所在的家目录（handoff.lock 放这里）。缺省 ~/.dsh
DSH_HOME=
# DSH 余额储备线（CNY）：dsh_balance.py 查到余额低于它就返回 3、停止新增派工。缺省 30，按自己的预算设
DSH_RESERVE_CNY=
# Codex CLI 可执行文件。缺省 ~/.npm-global/bin/codex，再退到 PATH 里的 codex
CODEX_BIN=
# agy（Google Antigravity）评审：agy-task.py 路径，缺省在 PATH 里找；agy_panel.py 用的 agy 命令在 PATH 里找
AGY_TASK=
# 跑 agy-task.py / agy_panel.py 的 Python 解释器。缺省 python3
AGY_PYTHON=
